{
  ModelName "DCP-7080"
  Attribute "NickName" "" "Brother DCP-7080, $USING"
  Attribute "1284DeviceID" "" "MFG:Brother;CMD:PJL,HBP;MDL:DCP-7080;CLS:PRINTER;CID:Brother Laser Type1;"
  // Brother HBP profile (models that share Brother's rastertobrother2300):
  // Brother's media names, tray PCL, paper-curl / toner-fixing PJL, native
  // duplex commands, 128-line bands, mode-1032 HQ1200 and status filter.
  Attribute "brlaserProfile" "" "brother-hbp"
  Filter application/vnd.cups-command 0 commandtobrlaser
  Attribute "cupsCommands" "" "ReportLevels PrintSelfTestPage"
  HWMargins 12 12 12 12
  Option Resolution PickOne AnySetup 10
    Choice "300dpi/300 DPI (draft)" "<</HWResolution[300 300]/cupsColorSpace 3/cupsBitsPerColor 1/cupsRowCount 0/cupsRowFeed 0/cupsRowStep 0>>setpagedevice"
    Choice "2400x600dpi/HQ1200 (Brother mode)" "<</HWResolution[1200 1200]/cupsColorSpace 3/cupsBitsPerColor 1/cupsRowCount 0/cupsRowFeed 0/cupsRowStep 0/cupsInteger12 3>>setpagedevice"
  CustomMedia "A5Rotated/A5 Long Edge" 595 420 12 12 12 12 "<</PageSize[595 420]/ImagingBBox null>>setpagedevice" "<</PageSize[595 420]/ImagingBBox null>>setpagedevice"
  CustomMedia "ISOB5/ISO B5" 499 709 12 12 12 12 "<</PageSize[499 709]/ImagingBBox null>>setpagedevice" "<</PageSize[499 709]/ImagingBBox null>>setpagedevice"
  CustomMedia "Env10/Envelope #10" 297 684 12 12 12 12 "<</PageSize[297 684]/ImagingBBox null>>setpagedevice" "<</PageSize[297 684]/ImagingBBox null>>setpagedevice"
  CustomMedia "FanFoldGermanLegal/Folio" 612 936 12 12 12 12 "<</PageSize[612 936]/ImagingBBox null>>setpagedevice" "<</PageSize[612 936]/ImagingBBox null>>setpagedevice"
  CustomMedia "3x5/3 x 5 in" 216 360 12 12 12 12 "<</PageSize[216 360]/ImagingBBox null>>setpagedevice" "<</PageSize[216 360]/ImagingBBox null>>setpagedevice"
  *InputSlot 0 "Auto/Auto (printer chooses)"
  InputSlot 1 "Tray1/Tray 1"
  InputSlot 5 "Manual/Manual feed slot"
  PCFileName "br7080.ppd"
}

