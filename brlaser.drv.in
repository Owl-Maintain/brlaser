  CustomMedia "3x5/3 x 5 in" 216 360 12 12 12 12 "<</PageSize[216 360]/ImagingBBox null>>setpagedevice" "<</PageSize[216 360]/ImagingBBox null>>setpagedevice"
  *InputSlot 0 "Auto/Auto (printer chooses)"
